# Bookit mobile — environment variables
# Copy to `.env` (git-ignored) and fill in real values.

# Base URL of the Bookit API.
# EXPO_PUBLIC_ prefix makes it available at runtime inside the app.
API_URL=http://localhost:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Sentry DSN for crash/error reporting. Leave blank to disable Sentry.
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=

# Stripe publishable key (client-side, safe to expose).
STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
